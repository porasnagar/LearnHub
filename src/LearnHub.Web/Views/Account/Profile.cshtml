@model ProfileViewModel
@{
    ViewData["Title"] = "Account";
    var u = Model.User;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Account settings</h1>
        <p class="page-sub">Your profile and sign-in details.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel">
            <div class="panel-body d-flex align-items-center gap-3">
                <span class="avatar avatar-lg">@Ui.Initials(u.FullName)</span>
                <div class="min-w-0">
                    <h2 class="h4 mb-1">@u.FullName</h2>
                    <span class="role role-@Ui.RoleCss(u.Role)">@u.Role</span>
                </div>
            </div>
            <div class="panel-body border-top">
                <dl class="facts">
                    <dt>Email</dt><dd class="text-break">@u.Email</dd>
                    <dt>Member since</dt><dd>@u.CreatedAt.ToString("MMMM d, yyyy")</dd>
                    @if (u.Role == UserRole.Student)
                    {
                        <dt>Enrolled in</dt><dd>@Ui.Plural(Model.CourseCount, "course")</dd>
                        <dt>Submissions</dt><dd>@Model.SubmissionCount</dd>
                    }
                    else
                    {
                        <dt>Teaching</dt><dd>@Ui.Plural(Model.CourseCount, "course")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <form asp-action="ChangePassword" method="post" class="panel" novalidate>
            <div class="panel-head"><h2 class="panel-title">Change password</h2></div>
            <div class="panel-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3" style="max-width: 420px">
                    <label asp-for="Password.CurrentPassword" class="form-label"></label>
                    <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password.CurrentPassword" class="small"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Password.NewPassword" class="form-label"></label>
                        <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                        <div class="form-text">At least 6 characters.</div>
                        <span asp-validation-for="Password.NewPassword" class="small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password.ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="Password.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password.ConfirmNewPassword" class="small"></span>
                    </div>
                </div>
            </div>
            <div class="panel-foot d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Update password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
