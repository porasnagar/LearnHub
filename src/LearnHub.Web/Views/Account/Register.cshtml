@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = "_AuthLayout";
}
<h1 class="auth-title">Create your account</h1>
<p class="text-muted mb-4">It takes less than a minute.</p>

<form asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <fieldset class="mb-3">
        <legend class="form-label">I'm joining as</legend>
        <div class="role-cards">
            <input type="radio" class="btn-check" asp-for="Role" value="@UserRole.Student" id="roleStudent" />
            <label class="role-card" for="roleStudent">
                <i class="bi bi-backpack2"></i>
                <span class="role-card-title">Student</span>
                <span class="role-card-text">Enroll in courses and hand in work</span>
            </label>
            <input type="radio" class="btn-check" asp-for="Role" value="@UserRole.Instructor" id="roleInstructor" />
            <label class="role-card" for="roleInstructor">
                <i class="bi bi-person-video3"></i>
                <span class="role-card-title">Instructor</span>
                <span class="role-card-text">Create courses and grade work</span>
            </label>
        </div>
    </fieldset>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" autocomplete="name" />
        <span asp-validation-for="FullName" class="small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email address</label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="small"></span>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <div class="form-text">At least 6 characters.</div>
            <span asp-validation-for="Password" class="small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="small"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Create account</button>
</form>

<p class="mt-4 mb-0">Already have an account? <a asp-action="Login" class="fw-semibold">Sign in</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
