@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}
<h1 class="auth-title">Sign in</h1>
<p class="text-muted mb-4">Welcome back. Sign in to your LearnHub account.</p>

<form asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email address</label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <button class="btn btn-default" type="button" data-toggle-password aria-label="Show password"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Password" class="small"></span>
    </div>
    <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
</form>

<p class="mt-4 mb-0">New to LearnHub? <a asp-action="Register" class="fw-semibold">Create an account</a></p>

<div class="demo-box">
    <div class="demo-head"><i class="bi bi-info-circle"></i> Demo environment: choose an account to fill in the form</div>
    <button type="button" class="demo-row" data-demo-email="admin@learnhub.local" data-demo-password="Admin@123">
        <span>Administrator</span><code>admin@learnhub.local</code>
    </button>
    <button type="button" class="demo-row" data-demo-email="priya@learnhub.local" data-demo-password="Teach@123">
        <span>Instructor</span><code>priya@learnhub.local</code>
    </button>
    <button type="button" class="demo-row" data-demo-email="aarav@learnhub.local" data-demo-password="Learn@123">
        <span>Student</span><code>aarav@learnhub.local</code>
    </button>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
