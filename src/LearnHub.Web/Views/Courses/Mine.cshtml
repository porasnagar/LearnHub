@model List<CourseCardViewModel>
@{
    var isStudent = User.IsInRole("Student");
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = "Courses";
}
<div class="page-head">
    <div>
        <h1 class="page-title">@(isAdmin ? "All courses" : "My courses")</h1>
        <p class="page-sub">
            @(isStudent ? "Courses you are enrolled in." : isAdmin ? "Every course on the platform." : "Courses you teach, including unpublished ones.")
        </p>
    </div>
    @if (isStudent)
    {
        <a asp-action="Index" class="btn btn-default"><i class="bi bi-collection"></i> Browse catalog</a>
    }
    else
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New course</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="panel empty">
        <p class="mb-2"><strong>@(isStudent ? "You're not enrolled in any courses yet." : "No courses yet.")</strong></p>
        <a asp-action="@(isStudent ? "Index" : "Create")" class="btn btn-primary btn-sm">@(isStudent ? "Find a course" : "Create a course")</a>
    </div>
}
else
{
    <partial name="_CourseTable" model="Model" />
}
