@model CourseFormViewModel
@{
    ViewData["Title"] = "New course";
}
<div class="page-head">
    <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a asp-action="Mine">Courses</a><span class="sep">/</span><span class="current">New course</span></nav>
        <h1 class="page-title">Create a course</h1>
        <p class="page-sub">You can change any of these details later in the course's settings.</p>
    </div>
</div>
<div class="row g-4">
    <div class="col-xl-8">
        <form asp-action="Create" method="post" class="panel" novalidate>
            <div class="panel-head"><h2 class="panel-title">Course details</h2></div>
            <div class="panel-body">
                <partial name="_CourseForm" model="Model" />
            </div>
            <div class="panel-foot d-flex justify-content-end gap-2">
                <a asp-action="Mine" class="btn btn-default">Cancel</a>
                <button type="submit" class="btn btn-primary">Create course</button>
            </div>
        </form>
    </div>
    <aside class="col-xl-4">
        <section class="panel">
            <div class="panel-head"><h2 class="panel-title">What happens next</h2></div>
            <ol class="panel-body mb-0 ps-4">
                <li class="mb-2">The course gets its own home page, assignments list, gradebook and class list.</li>
                <li class="mb-2">If it's published, students can find it in the catalog and enroll.</li>
                <li>Add assignments with due dates, and they'll appear on enrolled students' dashboards and calendars.</li>
            </ol>
        </section>
    </aside>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
