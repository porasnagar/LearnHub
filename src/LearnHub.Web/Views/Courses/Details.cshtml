@model CourseHomeViewModel
@{
    Layout = "_CourseLayout";
    var ctx = (CourseContext)ViewData["CourseContext"]!;
    var c = ctx.Course;
    ViewData["Title"] = c.Title;
    var pct = Model.AssignmentCount == 0 ? 0 : Model.Submitted * 100 / Model.AssignmentCount;
}
<div class="row g-4">
    <div class="@(ctx.CanSeeContent ? "col-xl-8" : "col-lg-8")">
        <section class="panel">
            <div class="panel-head"><h2 class="panel-title">About this course</h2></div>
            <div class="panel-body prose text-pre">@c.Description</div>
        </section>

        @if (ctx.CanSeeContent)
        {
            <section class="panel">
                <div class="panel-head">
                    <h2 class="panel-title">Upcoming assignments</h2>
                    <a asp-action="Assignments" asp-route-id="@c.Id" class="small fw-semibold text-decoration-none">All assignments (@Model.AssignmentCount)</a>
                </div>
                @if (Model.Upcoming.Count == 0)
                {
                    <div class="empty">
                        No upcoming due dates.
                        @if (ctx.CanManage) { <a asp-controller="Assignments" asp-action="Create" asp-route-courseId="@c.Id">Create an assignment</a> }
                    </div>
                }
                else
                {
                    <ul class="item-list">
                        @foreach (var row in Model.Upcoming)
                        {
                            var a = row.Assignment;
                            <li class="item">
                                <div class="date-block"><span class="m">@a.DueDate.ToString("MMM")</span><span class="d">@a.DueDate.Day</span></div>
                                <div class="min-w-0 flex-grow-1">
                                    <a class="item-title" asp-controller="Assignments" asp-action="Details" asp-route-id="@a.Id">@a.Title</a>
                                    <div class="item-meta">Due @Ui.When(a.DueDate) · @a.MaxPoints pts</div>
                                </div>
                                <div class="text-end">
                                    @if (ctx.CanManage)
                                    {
                                        <span class="small text-muted">@row.SubmissionCount submitted</span>
                                    }
                                    else
                                    {
                                        var st = Ui.WorkStatus(row.MySubmission, a);
                                        <span class="status status-@st.Css">@st.Label</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    </div>

    <aside class="@(ctx.CanSeeContent ? "col-xl-4" : "col-lg-4")" aria-label="Course information">
        @if (ctx.IsEnrolled)
        {
            <section class="panel">
                <div class="panel-head"><h2 class="panel-title">Your progress</h2></div>
                <div class="panel-body">
                    <div class="d-flex justify-content-between align-items-end mb-2">
                        <div>
                            <div class="small text-muted">Current grade</div>
                            @if (Model.Grade?.Percent is double p)
                            {
                                <div class="grade-big">@p.ToString("0")<small>%</small></div>
                            }
                            else
                            {
                                <div class="grade-big text-muted">–</div>
                            }
                        </div>
                        @if (Model.Grade?.Letter is string letter) { <span class="letter">@letter</span> }
                    </div>
                    <div class="meter mt-3"><span style="width: @pct%"></span></div>
                    <div class="small text-muted mt-1">@Model.Submitted of @Model.AssignmentCount assignments submitted</div>
                </div>
                <div class="panel-foot d-flex justify-content-between align-items-center">
                    <a asp-action="Grades" asp-route-id="@c.Id" class="fw-semibold text-decoration-none">View grades</a>
                    <form asp-action="Unenroll" asp-route-id="@c.Id" method="post" data-confirm="Leave @c.Code? You can enroll again later, and your submissions are kept.">
                        <button type="submit" class="btn btn-link btn-link-muted btn-sm">Leave course</button>
                    </form>
                </div>
            </section>
        }
        else if (ctx.CanManage)
        {
            <section class="panel">
                <div class="panel-head">
                    <h2 class="panel-title">Course status</h2>
                    <span class="status @(c.IsPublished ? "status-published" : "status-draft")">@(c.IsPublished ? "Published" : "Unpublished")</span>
                </div>
                <div class="panel-body">
                    <dl class="facts">
                        <dt>Students</dt><dd>@ctx.StudentCount</dd>
                        <dt>Assignments</dt><dd>@Model.AssignmentCount</dd>
                        <dt>To grade</dt><dd>@(Model.ToGrade > 0 ? $"{Model.ToGrade} submission(s)" : "None")</dd>
                    </dl>
                </div>
                <div class="panel-foot d-grid gap-2">
                    <a asp-controller="Assignments" asp-action="Create" asp-route-courseId="@c.Id" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New assignment</a>
                    <a asp-action="Grades" asp-route-id="@c.Id" class="btn btn-default btn-sm">Open gradebook</a>
                </div>
            </section>
        }
        else
        {
            <section class="panel">
                <div class="panel-head"><h2 class="panel-title">Course content</h2></div>
                <div class="panel-body">
                    <p class="mb-3">This course has <strong>@Ui.Plural(Model.AssignmentCount, "assignment")</strong>. Enroll to see the coursework, submit your work and get feedback.</p>
                    @if (ctx.IsStudent)
                    {
                        <form asp-action="Enroll" asp-route-id="@c.Id" method="post">
                            <button type="submit" class="btn btn-primary w-100">Enroll in this course</button>
                        </form>
                    }
                    else if (!ctx.IsSignedIn)
                    {
                        <a class="btn btn-primary w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in to enroll</a>
                        <div class="small text-muted mt-2 text-center">No account? <a asp-controller="Account" asp-action="Register">Create one</a></div>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">Only student accounts can enroll in courses.</p>
                    }
                </div>
            </section>
        }

        <section class="panel">
            <div class="panel-head"><h2 class="panel-title">Instructor</h2></div>
            <div class="panel-body d-flex align-items-center gap-3">
                <span class="avatar">@Ui.Initials(c.Instructor!.FullName)</span>
                <div class="min-w-0">
                    <div class="fw-semibold">@c.Instructor.FullName</div>
                    @if (ctx.CanSeeContent)
                    {
                        <a class="small text-break" href="mailto:@c.Instructor.Email">@c.Instructor.Email</a>
                    }
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="panel-head"><h2 class="panel-title">Course details</h2></div>
            <div class="panel-body">
                <dl class="facts">
                    <dt>Code</dt><dd>@c.Code</dd>
                    <dt>Subject</dt><dd>@c.Category</dd>
                    <dt>Credits</dt><dd>@c.Credits</dd>
                    <dt>Enrolled</dt><dd>@Ui.Plural(ctx.StudentCount, "student")</dd>
                    <dt>Created</dt><dd>@c.CreatedAt.ToString("MMM d, yyyy")</dd>
                </dl>
            </div>
        </section>
    </aside>
</div>
