@{
    Layout = "_CourseLayout";
    var ctx = (CourseContext)ViewData["CourseContext"]!;
    var c = ctx.Course;
    ViewData["Title"] = "Delete " + c.Code;
    ViewData["Crumb"] = "Delete";
}
<section class="panel panel-danger" style="max-width: 720px">
    <div class="panel-head"><h2 class="panel-title">Delete @c.Code</h2></div>
    <div class="panel-body">
        <p>You are about to permanently delete <strong>@c.Title</strong>. This also removes:</p>
        <ul>
            <li>@Ui.Plural(ctx.StudentCount, "student enrollment")</li>
            <li>@Ui.Plural((int)ViewBag.AssignmentCount, "assignment")</li>
            <li>@Ui.Plural((int)ViewBag.SubmissionCount, "submission"), including uploaded files and grades</li>
        </ul>
        <p class="mb-0 text-muted">This can't be undone.</p>
    </div>
    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="panel-foot d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-default">Cancel</a>
        <button type="submit" class="btn btn-danger">Delete permanently</button>
    </form>
</section>
