@model CourseFormViewModel
@{
    Layout = "_CourseLayout";
    var ctx = (CourseContext)ViewData["CourseContext"]!;
    ViewData["Title"] = "Settings · " + ctx.Course.Code;
}
<h2 class="section-title">Course settings</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel" novalidate>
    <div class="panel-head"><h3 class="panel-title">Course details</h3></div>
    <div class="panel-body">
        <partial name="_CourseForm" model="Model" />
    </div>
    <div class="panel-foot d-flex justify-content-end gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default">Cancel</a>
        <button type="submit" class="btn btn-primary">Save settings</button>
    </div>
</form>

<section class="panel panel-danger">
    <div class="panel-head"><h3 class="panel-title">Delete course</h3></div>
    <div class="panel-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <p class="mb-0">Permanently deletes the course with its enrollments, assignments, submissions and grades.<br />
            <span class="small text-muted">To hide the course temporarily, unpublish it instead.</span></p>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete this course</a>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
