@model CourseCatalogViewModel
@{
    ViewData["Title"] = "Course catalog";
    var filtered = !string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.Category);
}
<div class="page-head">
    <div>
        <nav class="crumbs" aria-label="Breadcrumb">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index">Home</a>
            }
            <span class="sep">/</span><span class="current">Course catalog</span>
        </nav>
        <h1 class="page-title">Course catalog</h1>
        <p class="page-sub">@Ui.Plural(Model.TotalPublished, "course") open for enrollment.</p>
    </div>
</div>

<div class="row g-4">
    <aside class="col-lg-3" aria-label="Filters">
        <form method="get" asp-action="Index" class="panel mb-3" role="search">
            <div class="panel-head"><h2 class="panel-title">Search</h2></div>
            <div class="panel-body">
                <input type="hidden" name="category" value="@Model.Category" />
                <div class="input-group">
                    <input type="search" name="q" value="@Model.Query" class="form-control" placeholder="Title, code or topic" aria-label="Search courses" />
                    <button class="btn btn-primary" type="submit" aria-label="Search"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
        <div class="panel">
            <div class="panel-head"><h2 class="panel-title">Subject</h2></div>
            <ul class="filter-list">
                <li>
                    <a class="@(string.IsNullOrEmpty(Model.Category) ? "active" : "")" asp-action="Index" asp-route-q="@Model.Query">
                        <span>All subjects</span><span class="count">@Model.TotalPublished</span>
                    </a>
                </li>
                @foreach (var s in Model.Subjects)
                {
                    <li>
                        <a class="@(s.Name == Model.Category ? "active" : "")" asp-action="Index" asp-route-category="@s.Name" asp-route-q="@Model.Query">
                            <span>@s.Name</span><span class="count">@s.Count</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </aside>

    <div class="col-lg-9">
        <div class="panel">
            <div class="panel-head">
                <h2 class="panel-title">
                    @Ui.Plural(Model.Courses.Count, "result")
                    @if (!string.IsNullOrWhiteSpace(Model.Category)) { <span class="count">in @Model.Category</span> }
                    @if (!string.IsNullOrWhiteSpace(Model.Query)) { <span class="count">for “@Model.Query”</span> }
                </h2>
                @if (filtered) { <a asp-action="Index" class="small fw-semibold text-decoration-none">Clear filters</a> }
            </div>
            @if (Model.Courses.Count == 0)
            {
                <div class="empty">No courses match your search. Try a different word or <a asp-action="Index">clear the filters</a>.</div>
            }
            else
            {
                @foreach (var c in Model.Courses)
                {
                    <article class="catalog-row" style="--c: @Ui.CourseColor(c.Id)">
                        <a class="course-tile graph" asp-action="Details" asp-route-id="@c.Id" tabindex="-1" aria-hidden="true">@c.Code</a>
                        <div class="flex-grow-1 min-w-0">
                            <div class="overline-dark">@c.Category</div>
                            <h3 class="catalog-title"><a asp-action="Details" asp-route-id="@c.Id">@c.Title</a></h3>
                            <div class="catalog-meta">
                                <span>@c.InstructorName</span>
                                <span>@c.Code</span>
                                <span>@c.Credits credits</span>
                                <span>@c.StudentCount enrolled</span>
                            </div>
                            <p class="catalog-desc">@Ui.Truncate(c.Description, 190)</p>
                        </div>
                        <div class="catalog-action">
                            @if (c.IsEnrolled)
                            {
                                <span class="status status-graded">Enrolled</span>
                            }
                            else
                            {
                                <a class="btn btn-default btn-sm" asp-action="Details" asp-route-id="@c.Id">View course</a>
                            }
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</div>
