@model AdminUsersViewModel
@{
    ViewData["Title"] = "Users · Administration";
    var myId = User.GetUserId();
    var total = Model.Counts.Values.Sum();
}
<div class="page-head">
    <div>
        <nav class="crumbs" aria-label="Breadcrumb"><span>Administration</span><span class="sep">/</span><span class="current">Users</span></nav>
        <h1 class="page-title">Administration</h1>
    </div>
</div>
<partial name="_AdminTabs" />

<div class="figures mb-4">
    <div class="figure"><div class="figure-label">All accounts</div><div class="figure-value">@total</div></div>
    @foreach (var r in Enum.GetValues<UserRole>())
    {
        <div class="figure"><div class="figure-label">@(r)s</div><div class="figure-value">@Model.Counts.GetValueOrDefault(r)</div></div>
    }
</div>

<div class="panel">
    <form method="get" asp-action="Users" class="panel-head flex-wrap" role="search">
        <div class="d-flex flex-wrap gap-2 flex-grow-1">
            <input type="search" name="q" value="@Model.Query" class="form-control form-control-sm" style="max-width: 280px" placeholder="Search name or email" aria-label="Search users" />
            <select name="role" class="form-select form-select-sm" style="max-width: 170px" aria-label="Role" data-autosubmit>
                <option value="">All roles</option>
                @foreach (var r in Enum.GetValues<UserRole>())
                {
                    <option value="@r" selected="@(Model.Role == r)">@(r)s</option>
                }
            </select>
            <button class="btn btn-default btn-sm" type="submit">Filter</button>
        </div>
        <span class="small text-muted">@Ui.Plural(Model.Users.Count, "account") shown</span>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Name</th><th>Role</th><th class="d-none d-lg-table-cell">Activity</th><th class="d-none d-md-table-cell">Joined</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Users)
                {
                    var u = row.User;
                    var isMe = u.Id == myId;
                    <tr>
                        <td>
                            <div class="cell-person">
                                <span class="avatar avatar-sm">@Ui.Initials(u.FullName)</span>
                                <div class="min-w-0">
                                    <div class="name">@u.FullName @if (isMe) { <span class="small text-muted fw-normal">(you)</span> }</div>
                                    <div class="sub text-break">@u.Email</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="role role-@Ui.RoleCss(u.Role)">@u.Role</span></td>
                        <td class="d-none d-lg-table-cell small text-muted">
                            @(u.Role == UserRole.Instructor ? $"Teaches {Ui.Plural(row.CoursesTaught, "course")}" : u.Role == UserRole.Student ? $"Enrolled in {Ui.Plural(row.Enrollments, "course")}" : "Platform administrator")
                        </td>
                        <td class="d-none d-md-table-cell small text-muted">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td class="text-end">
                            @if (!isMe)
                            {
                                <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                    <form asp-action="ChangeRole" asp-route-id="@u.Id" method="post" class="d-inline-flex gap-1">
                                        <select name="role" class="form-select form-select-sm" style="width: 8.5rem" aria-label="Role for @u.FullName">
                                            @foreach (var r in Enum.GetValues<UserRole>())
                                            {
                                                <option value="@r" selected="@(u.Role == r)">@r</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-default btn-sm">Apply</button>
                                    </form>
                                    <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" data-confirm="Delete @u.FullName's account? Their enrollments and submissions will be removed.">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Delete @u.FullName"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Users.Count == 0)
    {
        <div class="empty">No accounts match these filters.</div>
    }
</div>
