@model GradeViewModel
@{
    var s = Model.Submission!;
    var a = s.Assignment!;
    ViewData["Title"] = "Grade · " + s.Student!.FullName;
    ViewData["Wide"] = true;
    var late = s.SubmittedAt > a.DueDate;
}
<div style="--c: @Ui.CourseColor(a.CourseId)">
    <nav class="crumbs" aria-label="Breadcrumb">
        <a asp-controller="Courses" asp-action="Details" asp-route-id="@a.CourseId">@a.Course!.Code</a><span class="sep">/</span>
        <a asp-controller="Courses" asp-action="Assignments" asp-route-id="@a.CourseId">Assignments</a><span class="sep">/</span>
        <a asp-controller="Assignments" asp-action="Details" asp-route-id="@a.Id">@Ui.Truncate(a.Title, 40)</a><span class="sep">/</span>
        <span class="current">Grading</span>
    </nav>

    <div class="grader-bar">
        <div class="min-w-0">
            <div class="overline-dark"><span class="course-tag">@a.Course!.Code</span> · @a.MaxPoints pts · due @Ui.When(a.DueDate)</div>
            <h1 class="mt-1">@a.Title</h1>
        </div>
        <div class="student-switch" aria-label="Choose submission">
            @if (Model.PrevId is int prev)
            {
                <a class="btn btn-default" asp-action="Grade" asp-route-id="@prev" aria-label="Previous student"><i class="bi bi-chevron-left"></i></a>
            }
            else
            {
                <button class="btn btn-default" disabled aria-label="Previous student"><i class="bi bi-chevron-left"></i></button>
            }
            <select class="form-select" data-nav-select aria-label="Student">
                @foreach (var q in Model.Queue)
                {
                    <option value="@Url.Action("Grade", new { id = q.SubmissionId })" selected="@(q.SubmissionId == s.Id)">
                        @q.StudentName @(q.IsGraded ? "✓" : "· needs grading")
                    </option>
                }
            </select>
            @if (Model.NextId is int next)
            {
                <a class="btn btn-default" asp-action="Grade" asp-route-id="@next" aria-label="Next student"><i class="bi bi-chevron-right"></i></a>
            }
            else
            {
                <button class="btn btn-default" disabled aria-label="Next student"><i class="bi bi-chevron-right"></i></button>
            }
            <span class="small text-muted text-nowrap ms-1">@Model.Position of @Model.Queue.Count</span>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="viewer">
                <div class="viewer-head">
                    <span class="avatar">@Ui.Initials(s.Student.FullName)</span>
                    <div class="me-auto">
                        <div class="fw-semibold">@s.Student.FullName</div>
                        <div class="small text-muted">Submitted @s.SubmittedAt.ToString("ddd, MMM d 'at' h:mm tt")</div>
                    </div>
                    <span class="status @(late ? "status-late" : "status-graded")">@(late ? "Late" : "On time")</span>
                </div>
                <article class="doc text-pre" aria-label="Submission text">@if (string.IsNullOrEmpty(s.TextAnswer)) {<span class="doc-empty">No text entry. See the attached file.</span>} else {<text>@s.TextAnswer</text>}</article>
                @if (s.OriginalFileName is not null)
                {
                    <div class="file-card">
                        <i class="bi bi-file-earmark-text"></i>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold text-truncate">@s.OriginalFileName</div>
                            <div class="small text-muted">Attached file</div>
                        </div>
                        <a asp-controller="Assignments" asp-action="Download" asp-route-id="@s.Id" class="btn btn-default btn-sm"><i class="bi bi-download"></i> Download</a>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <form asp-action="Grade" method="post" class="panel" novalidate>
                <div class="panel-head">
                    <h2 class="panel-title">Assessment</h2>
                    @if (s.IsGraded) { <span class="status status-graded">Graded @s.GradedAt?.ToString("MMM d")</span> } else { <span class="status status-pending">Needs grading</span> }
                </div>
                <div class="panel-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="SubmissionId" />
                    <label asp-for="Score" class="form-label">Score</label>
                    <div class="d-flex align-items-center gap-3">
                        <div class="input-group" style="max-width: 190px">
                            <input asp-for="Score" type="number" inputmode="decimal" class="form-control form-control-lg" min="0" max="@a.MaxPoints" step="0.5"
                                   data-grade-input data-max="@a.MaxPoints" autofocus />
                            <span class="input-group-text">/ @a.MaxPoints</span>
                        </div>
                        <span class="letter" data-grade-letter aria-live="polite">@(Model.Score is double sc ? Ui.LetterGrade(sc / a.MaxPoints * 100) : "–")</span>
                    </div>
                    <span asp-validation-for="Score" class="small"></span>

                    <div class="mt-3">
                        <label asp-for="Feedback" class="form-label"></label>
                        <textarea asp-for="Feedback" class="form-control" rows="8" placeholder="What went well, and what to improve next time" data-counter maxlength="2000"></textarea>
                        <span asp-validation-for="Feedback" class="small"></span>
                    </div>
                </div>
                <div class="panel-foot d-flex flex-wrap justify-content-end gap-2">
                    <button type="submit" class="btn btn-default">Save</button>
                    <button type="submit" name="SaveAndNext" value="true" class="btn btn-primary">Save &amp; next <i class="bi bi-arrow-right"></i></button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
