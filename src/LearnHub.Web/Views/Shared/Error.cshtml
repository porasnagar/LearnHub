@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="status-page">
    <div class="status-code">500</div>
    <h1 class="page-title mt-2">Something went wrong</h1>
    <p class="text-muted mt-2">An unexpected error occurred while processing your request. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Go to home page</a>
</div>
