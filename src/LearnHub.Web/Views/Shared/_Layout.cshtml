@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var wide = ViewData["Wide"] as bool? == true;
    var bleed = ViewData["Bleed"] as bool? == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadAssets" />
</head>
<body class="@(signedIn ? "is-app" : "is-public")">
    <a class="skip-link" href="#main">Skip to content</a>
    @if (signedIn)
    {
        <aside class="rail d-none d-lg-flex" aria-label="LearnHub">
            <a class="rail-logo" asp-controller="Dashboard" asp-action="Index" title="LearnHub dashboard">
                <partial name="_LogoMark" model="38" />
            </a>
            <partial name="_GlobalNav" model="@("rail")" />
        </aside>

        <header class="topbar d-lg-none">
            <button class="topbar-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#navDrawer" aria-controls="navDrawer" aria-label="Open menu">
                <i class="bi bi-list"></i>
            </button>
            <a class="topbar-brand" asp-controller="Dashboard" asp-action="Index"><partial name="_LogoMark" model="28" /> LearnHub</a>
            <a class="avatar avatar-sm ms-auto" asp-controller="Account" asp-action="Profile" aria-label="Account">@Ui.Initials(User.Identity!.Name!)</a>
        </header>
        <div class="offcanvas offcanvas-start drawer" tabindex="-1" id="navDrawer" aria-labelledby="navDrawerLabel">
            <div class="offcanvas-header">
                <div class="d-flex align-items-center gap-2" id="navDrawerLabel">
                    <partial name="_LogoMark" model="30" /><span class="serif fs-5 text-white">LearnHub</span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0 d-flex flex-column">
                <partial name="_GlobalNav" model="@("drawer")" />
            </div>
        </div>

        <div class="app-main">
            <main id="main" class="app-content@(wide ? " app-content-wide" : "")">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
            <footer class="app-footer">LearnHub Learning Management System · ASP.NET Core MVC</footer>
        </div>
    }
    else
    {
        <header class="site-header">
            <nav class="navbar navbar-expand-md container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <partial name="_LogoMark" model="34" /><span class="wordmark">LearnHub</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-controls="siteNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2"></i>
                </button>
                <div class="collapse navbar-collapse" id="siteNav">
                    <ul class="navbar-nav me-auto ms-md-4">
                        <li class="nav-item"><a class="nav-link@(controller == "Courses" ? " active" : "")" asp-controller="Courses" asp-action="Index">Course catalog</a></li>
                        <li class="nav-item"><a class="nav-link@(controller == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "About" ? " active" : "")" asp-controller="Home" asp-action="About">About</a></li>
                    </ul>
                    <div class="d-flex gap-2 pb-2 pb-md-0">
                        <a class="btn btn-default" asp-controller="Account" asp-action="Login">Sign in</a>
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create account</a>
                    </div>
                </div>
            </nav>
        </header>
        <main id="main" class="public-main">
            @if (bleed)
            {
                <div class="container"><partial name="_Alerts" /></div>
                @RenderBody()
            }
            else
            {
                <div class="container py-4">
                    <partial name="_Alerts" />
                    @RenderBody()
                </div>
            }
        </main>
        <partial name="_SiteFooter" />
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
