@{
    Layout = "_Layout";
    var ctx = (CourseContext)ViewData["CourseContext"]!;
    var c = ctx.Course;
    var crumb = ViewData["Crumb"] as string;
    string Tab(string t) => ctx.ActiveTab == t ? "active" : "";
    (string? Item1, string? Item2) tabName = ctx.ActiveTab switch
    {
        "assignments" => ("Assignments", "Assignments"),
        "grades" => ("Grades", "Grades"),
        "people" => ("People", "Roster"),
        "settings" => ("Settings", "Edit"),
        _ => (null, null)
    };
    var fromCatalog = !ctx.CanSeeContent;
}
<div style="--c: @ctx.Color">
    <nav class="crumbs" aria-label="Breadcrumb">
        @if (fromCatalog)
        {
            <a asp-controller="Courses" asp-action="Index">Course catalog</a>
        }
        else
        {
            <a asp-controller="Courses" asp-action="Mine">Courses</a>
        }
        <span class="sep">/</span>
        @if (tabName.Item1 is null && crumb is null)
        {
            <span class="current">@c.Code</span>
        }
        else
        {
            <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id">@c.Code</a>
            @if (tabName.Item1 is not null)
            {
                <span class="sep">/</span>
                @if (crumb is null)
                {
                    <span class="current">@tabName.Item1</span>
                }
                else
                {
                    <a asp-controller="Courses" asp-action="@tabName.Item2" asp-route-id="@c.Id">@tabName.Item1</a>
                }
            }
            @if (crumb is not null)
            {
                <span class="sep">/</span><span class="current">@crumb</span>
            }
        }
    </nav>

    <header class="course-hero graph">
        <div class="course-hero-inner">
            <div class="min-w-0">
                <div class="course-eyebrow">@c.Code &middot; @c.Category</div>
                <h1 class="course-hero-title">@c.Title</h1>
                <div class="course-hero-meta">
                    <span><i class="bi bi-person"></i> @c.Instructor!.FullName</span>
                    <span>@c.Credits credits</span>
                    <span>@Ui.Plural(ctx.StudentCount, "student")</span>
                    @if (!c.IsPublished) { <span class="status status-on-dark">Unpublished</span> }
                </div>
            </div>
            <div>
                @if (ctx.IsEnrolled)
                {
                    <span class="enrolled-flag"><i class="bi bi-check2-circle"></i> Enrolled</span>
                }
                else if (ctx.IsStudent && c.IsPublished)
                {
                    <form asp-controller="Courses" asp-action="Enroll" asp-route-id="@c.Id" method="post">
                        <button type="submit" class="btn btn-on-dark">Enroll in this course</button>
                    </form>
                }
                else if (!ctx.IsSignedIn)
                {
                    <a class="btn btn-on-dark" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in to enroll</a>
                }
                else if (ctx.CanManage)
                {
                    <a class="btn btn-on-dark" asp-controller="Assignments" asp-action="Create" asp-route-courseId="@c.Id"><i class="bi bi-plus-lg"></i> New assignment</a>
                }
            </div>
        </div>
    </header>

    @if (ctx.CanSeeContent)
    {
        <div class="row g-4">
            <div class="col-lg-2">
                <nav class="course-nav" aria-label="Course">
                    <a class="@Tab("home")" asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id">Home</a>
                    <a class="@Tab("assignments")" asp-controller="Courses" asp-action="Assignments" asp-route-id="@c.Id">Assignments</a>
                    <a class="@Tab("grades")" asp-controller="Courses" asp-action="Grades" asp-route-id="@c.Id">Grades</a>
                    @if (ctx.CanManage)
                    {
                        <a class="@Tab("people")" asp-controller="Courses" asp-action="Roster" asp-route-id="@c.Id">People</a>
                        <a class="@Tab("settings")" asp-controller="Courses" asp-action="Edit" asp-route-id="@c.Id">Settings</a>
                    }
                </nav>
            </div>
            <div class="col-lg-10">
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
