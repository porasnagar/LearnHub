@model CourseCardViewModel
<a class="catalog-card" style="--c: @Ui.CourseColor(Model.Id)" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Id">
    <div class="course-banner graph"><span class="course-banner-code">@Model.Code</span></div>
    <div class="catalog-card-body">
        <div class="overline-dark">@Model.Category</div>
        <h3 class="catalog-card-title">@Model.Title</h3>
        <div class="small text-muted">@Model.InstructorName</div>
        <div class="catalog-card-meta">
            <span><i class="bi bi-award"></i> @Model.Credits credits</span>
            <span><i class="bi bi-people"></i> @Model.StudentCount enrolled</span>
            <span><i class="bi bi-clipboard-check"></i> @Ui.Plural(Model.AssignmentCount, "assignment")</span>
        </div>
    </div>
</a>
