@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-start gap-2" role="status" data-autodismiss>
        <i class="bi bi-check-circle mt-1"></i><span>@success</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-circle mt-1"></i><span>@error</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
    </div>
}
