<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadAssets" />
</head>
<body>
    <div class="auth">
        <aside class="auth-aside graph-dark" aria-label="About LearnHub">
            <a class="auth-brand" asp-controller="Home" asp-action="Index"><partial name="_LogoMark" model="36" /> LearnHub</a>
            <div class="auth-statement">
                <div class="overline">Learning management system</div>
                <h2>Your courses, coursework and grades, all in one place.</h2>
                <ul class="auth-points">
                    <li><i class="bi bi-calendar-check"></i><span>Every due date from every course on one calendar</span></li>
                    <li><i class="bi bi-chat-square-text"></i><span>Written feedback from instructors on each submission</span></li>
                    <li><i class="bi bi-bar-chart-line"></i><span>Up-to-date grades for every course you take or teach</span></li>
                </ul>
            </div>
            <div class="auth-foot">&copy; @DateTime.Now.Year LearnHub</div>
        </aside>
        <main class="auth-main" id="main">
            <div class="auth-form">
                <a class="auth-brand-mobile d-lg-none" asp-controller="Home" asp-action="Index">
                    <partial name="_LogoMark" model="34" /><span class="wordmark">LearnHub</span>
                </a>
                <partial name="_Alerts" />
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
