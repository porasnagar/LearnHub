@{
    int code = ViewBag.Code;
    var (title, text) = code switch
    {
        404 => ("Page not found", "The page or item you were looking for doesn't exist, or it has been removed."),
        403 => ("You don't have access to this page", "Your account doesn't have permission to view it."),
        _ => ("Something went wrong", "The request could not be completed.")
    };
    ViewData["Title"] = title;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<div class="status-page">
    <div class="status-code">@code</div>
    <h1 class="page-title mt-2">@title</h1>
    <p class="text-muted mt-2">@text</p>
    <div class="d-flex gap-2 mt-4">
        @if (signedIn)
        {
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Go to dashboard</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to home page</a>
        }
        <a asp-controller="Courses" asp-action="Index" class="btn btn-default">Browse the catalog</a>
    </div>
</div>
