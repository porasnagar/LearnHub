@{
    ViewData["Title"] = "About";
}
<div class="page-head">
    <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span class="sep">/</span><span class="current">About</span></nav>
        <h1 class="page-title">About LearnHub</h1>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel">
            <div class="panel-body prose">
                <p>
                    LearnHub is an online learning management system built with the ASP.NET Core MVC framework,
                    Entity Framework Core and Bootstrap. It brings a course's syllabus, assignments, submissions,
                    feedback and grades together in one place, and works on phones, tablets and desktops.
                </p>
            </div>
        </div>
        <div class="panel" id="roles">
            <div class="panel-head"><h2 class="panel-title">Roles &amp; permissions</h2></div>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Role</th><th>Can do</th></tr></thead>
                    <tbody>
                        <tr><td><span class="role role-student">Student</span></td><td>Browse the catalog, enroll and leave courses, submit and resubmit work until it is graded, and view grades and feedback.</td></tr>
                        <tr><td><span class="role role-instructor">Instructor</span></td><td>Create, publish and edit their own courses; set assignments; grade submissions; view the class list and gradebook; export grades.</td></tr>
                        <tr><td><span class="role role-admin">Admin</span></td><td>Everything an instructor can do on every course, plus managing user accounts and roles.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel">
            <div class="panel-head"><h2 class="panel-title">Get started</h2></div>
            <div class="panel-body d-grid gap-2">
                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create an account</a>
                <a class="btn btn-default" asp-controller="Courses" asp-action="Index">Browse the catalog</a>
            </div>
        </div>
    </div>
</div>
