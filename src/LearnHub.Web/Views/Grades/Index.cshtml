@model List<CourseGradeRow>
@{
    ViewData["Title"] = "Grades";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Grades</h1>
        <p class="page-sub">Your current grade in each course, based on the work that has been graded so far.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="panel empty">
        <p class="mb-2"><strong>You're not enrolled in any courses.</strong></p>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-sm">Browse the catalog</a>
    </div>
}
else
{
    <div class="panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Course</th><th class="d-none d-md-table-cell">Graded</th><th>Points</th><th class="text-end">Current grade</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr style="--c: @Ui.CourseColor(r.CourseId)">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="swatch" style="width: 14px; height: 36px"></span>
                                    <div class="min-w-0">
                                        <a class="fw-semibold text-decoration-none" asp-controller="Courses" asp-action="Grades" asp-route-id="@r.CourseId">@r.Title</a>
                                        <div class="small text-muted">@r.Code · @r.InstructorName</div>
                                    </div>
                                </div>
                            </td>
                            <td class="d-none d-md-table-cell">@r.Summary.GradedCount of @r.AssignmentCount</td>
                            <td class="small text-muted">@(r.Summary.GradedCount == 0 ? "–" : $"{Ui.Score(r.Summary.Earned)} / {r.Summary.Possible}")</td>
                            <td class="text-end">
                                @if (r.Summary.Percent is double p)
                                {
                                    <span class="score me-2">@p.ToString("0.#")%</span><span class="letter letter-sm">@r.Summary.Letter</span>
                                }
                                else
                                {
                                    <span class="text-muted">No grades yet</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
