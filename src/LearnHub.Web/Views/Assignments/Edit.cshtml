@model AssignmentFormViewModel
@{
    Layout = "_CourseLayout";
    ViewData["Title"] = "Edit assignment";
    ViewData["Crumb"] = "Edit";
}
<h2 class="section-title">Edit assignment</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel" novalidate>
    <div class="panel-head"><h3 class="panel-title">Assignment details</h3></div>
    <div class="panel-body">
        <partial name="_AssignmentForm" model="Model" />
    </div>
    <div class="panel-foot d-flex justify-content-end gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default">Cancel</a>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
