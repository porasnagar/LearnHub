@model AssignmentDetailsViewModel
@{
    Layout = "_CourseLayout";
    var a = Model.Assignment;
    ViewData["Title"] = a.Title;
    ViewData["Crumb"] = Ui.Truncate(a.Title, 40);
    var mine = Model.MySubmission;
    var status = Ui.WorkStatus(mine, a);
    var canSubmit = !Model.CanManage && (mine is null || !mine.IsGraded);

    var submitted = Model.Rows.Where(r => r.Submission is not null).ToList();
    var graded = submitted.Where(r => r.Submission!.IsGraded).ToList();
    var firstToGrade = submitted.FirstOrDefault(r => !r.Submission!.IsGraded) ?? submitted.FirstOrDefault();
}
<div class="row g-4">
    <div class="col-xl-8">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <h2 class="assignment-title">@a.Title</h2>
            @if (Model.CanManage)
            {
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-default btn-sm"><i class="bi bi-pencil"></i> Edit</a>
                    <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-outline-danger btn-sm" aria-label="Delete assignment"><i class="bi bi-trash"></i></a>
                </div>
            }
        </div>
        <div class="facts-bar">
            <div><span>Due</span>@Ui.WhenLong(a.DueDate)</div>
            <div><span>Points</span>@a.MaxPoints</div>
            <div><span>Submitting</span>a text entry or a file upload</div>
        </div>

        <section class="panel">
            <div class="panel-head"><h3 class="panel-title">Instructions</h3></div>
            <div class="panel-body prose text-pre">@a.Instructions</div>
        </section>

        @if (!Model.CanManage)
        {
            if (mine is not null)
            {
                <section class="panel">
                    <div class="panel-head">
                        <h3 class="panel-title">Your submission</h3>
                        <span class="small text-muted">@mine.SubmittedAt.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                    </div>
                    <div class="panel-body">
                        @if (!string.IsNullOrEmpty(mine.TextAnswer))
                        {
                            <div class="doc-inline text-pre">@mine.TextAnswer</div>
                        }
                        @if (mine.OriginalFileName is not null)
                        {
                            <div class="file-card ms-0 @(string.IsNullOrEmpty(mine.TextAnswer) ? "mt-0" : "")">
                                <i class="bi bi-file-earmark"></i>
                                <div class="flex-grow-1 min-w-0 text-truncate fw-semibold">@mine.OriginalFileName</div>
                                <a asp-action="Download" asp-route-id="@mine.Id" class="btn btn-default btn-sm"><i class="bi bi-download"></i> Download</a>
                            </div>
                        }
                    </div>
                    @if (canSubmit)
                    {
                        <div class="panel-foot d-flex flex-wrap align-items-center gap-2">
                            <button class="btn btn-default btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#submitForm" aria-expanded="false" aria-controls="submitForm">
                                <i class="bi bi-arrow-repeat"></i> Resubmit
                            </button>
                            <span class="small text-muted">You can replace your submission until it's graded.</span>
                        </div>
                    }
                </section>
            }

            if (canSubmit)
            {
                <section class="panel @(mine is null ? "" : "collapse")" id="submitForm">
                    <div class="panel-head"><h3 class="panel-title">@(mine is null ? "Submit assignment" : "Resubmit assignment")</h3></div>
                    <form asp-action="Submit" method="post" enctype="multipart/form-data">
                        <div class="panel-body">
                            @if (a.IsOverdue)
                            {
                                <div class="alert alert-warning">The due date has passed. You can still submit, but it will be marked late.</div>
                            }
                            <input type="hidden" name="AssignmentId" value="@a.Id" />
                            <div class="mb-3">
                                <label for="TextAnswer" class="form-label">Text entry</label>
                                <textarea id="TextAnswer" name="TextAnswer" class="form-control" rows="8" maxlength="8000" data-counter
                                          placeholder="Type your answer here, or attach a file below.">@mine?.TextAnswer</textarea>
                            </div>
                            <div>
                                <label for="Attachment" class="form-label">File upload <span class="fw-normal text-muted">(optional)</span></label>
                                <input id="Attachment" name="Attachment" type="file" class="form-control" data-max-mb="@Model.MaxFileSizeMB" accept="@Model.AllowedExtensions.Replace(" ", "")" />
                                <div class="form-text">
                                    Up to @Model.MaxFileSizeMB MB. Accepted: @Model.AllowedExtensions.
                                    @if (mine?.OriginalFileName is not null) { <text>Leave empty to keep <strong>@mine.OriginalFileName</strong>.</text> }
                                </div>
                            </div>
                        </div>
                        <div class="panel-foot d-flex justify-content-end gap-2">
                            @if (mine is not null)
                            {
                                <button type="button" class="btn btn-default" data-bs-toggle="collapse" data-bs-target="#submitForm">Cancel</button>
                            }
                            <button type="submit" class="btn btn-primary">Submit assignment</button>
                        </div>
                    </form>
                </section>
            }
        }
        else
        {
            <section class="panel">
                <div class="panel-head"><h3 class="panel-title">Submissions<span class="count">@submitted.Count</span></h3></div>
                @if (Model.Rows.Count == 0)
                {
                    <div class="empty">No students are enrolled in this course yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead><tr><th>Student</th><th>Status</th><th class="d-none d-md-table-cell">Submitted</th><th class="text-end">Score</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var r in Model.Rows)
                                {
                                    var s = r.Submission;
                                    var st = Ui.WorkStatus(s, a);
                                    <tr>
                                        <td>
                                            <div class="cell-person">
                                                <span class="avatar avatar-sm">@Ui.Initials(r.Student.FullName)</span>
                                                <div><div class="name">@r.Student.FullName</div>@if (!r.StillEnrolled) { <div class="sub">No longer enrolled</div> }</div>
                                            </div>
                                        </td>
                                        <td><span class="status status-@(s is not null && !s.IsGraded ? "pending" : st.Css)">@(s is not null && !s.IsGraded ? "Needs grading" : st.Label)</span></td>
                                        <td class="d-none d-md-table-cell small text-muted">@(s?.SubmittedAt.ToString("MMM d, h:mm tt") ?? "—")@if (s is not null && s.SubmittedAt > a.DueDate) { <span class="status status-late ms-1">Late</span> }</td>
                                        <td class="text-end">@if (s?.Score is double sc) { <span class="score">@Ui.Score(sc)<small>/@a.MaxPoints</small></span> } else { <span class="text-muted">–</span> }</td>
                                        <td class="text-end">
                                            @if (s is not null)
                                            {
                                                <a asp-controller="Submissions" asp-action="Grade" asp-route-id="@s.Id" class="btn btn-sm @(s.IsGraded ? "btn-default" : "btn-primary")">@(s.IsGraded ? "Review" : "Grade")</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>

    <aside class="col-xl-4" aria-label="Submission status">
        @if (!Model.CanManage)
        {
            <section class="panel">
                <div class="panel-head"><h3 class="panel-title">Submission</h3><span class="status status-@status.Css">@status.Label</span></div>
                <div class="panel-body">
                    @if (mine is null)
                    {
                        <p class="mb-0 @(a.IsOverdue ? "text-danger" : "text-muted")">
                            @(a.IsOverdue ? $"This assignment was due {Ui.When(a.DueDate)} and hasn't been submitted." : $"{Ui.DueText(a.DueDate)}. Use the form to hand in your work.")
                        </p>
                    }
                    else
                    {
                        <dl class="facts">
                            <dt>Submitted</dt><dd>@mine.SubmittedAt.ToString("MMM d, h:mm tt")</dd>
                            <dt>Timing</dt><dd>@(mine.SubmittedAt > a.DueDate ? "Late" : "On time")</dd>
                            @if (mine.OriginalFileName is not null) { <dt>File</dt><dd class="text-break">@mine.OriginalFileName</dd> }
                        </dl>
                    }
                </div>
                @if (mine?.Score is double score)
                {
                    <div class="panel-body border-top">
                        <div class="small text-muted mb-1">Grade</div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="grade-big">@Ui.Score(score)<small> / @a.MaxPoints</small></div>
                            <span class="letter">@Ui.LetterGrade(score / a.MaxPoints * 100)</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(mine.Feedback))
                    {
                        <div class="panel-body border-top">
                            <div class="small text-muted mb-2">Comments</div>
                            <div class="comment">
                                <span class="avatar avatar-sm">@Ui.Initials(a.Course!.Instructor!.FullName)</span>
                                <div class="min-w-0 flex-grow-1">
                                    <div class="comment-meta"><strong>@a.Course.Instructor.FullName</strong> · @mine.GradedAt?.ToString("MMM d")</div>
                                    <div class="comment-body text-pre">@mine.Feedback</div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </section>
        }
        else
        {
            var avg = graded.Count == 0 ? (double?)null : graded.Average(r => r.Submission!.Score!.Value);
            <section class="panel">
                <div class="panel-head"><h3 class="panel-title">Grading</h3></div>
                <div class="panel-body">
                    <dl class="facts">
                        <dt>Students</dt><dd>@Model.Rows.Count(r => r.StillEnrolled)</dd>
                        <dt>Submitted</dt><dd>@submitted.Count</dd>
                        <dt>Graded</dt><dd>@graded.Count</dd>
                        <dt>To grade</dt><dd>@(submitted.Count - graded.Count)</dd>
                        <dt>Average</dt><dd>@(avg is double v ? $"{Ui.Score(Math.Round(v, 1))} / {a.MaxPoints}" : "–")</dd>
                    </dl>
                </div>
                <div class="panel-foot d-grid gap-2">
                    @if (firstToGrade is not null)
                    {
                        <a asp-controller="Submissions" asp-action="Grade" asp-route-id="@firstToGrade.Submission!.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-pencil-square"></i> @(graded.Count < submitted.Count ? "Start grading" : "Review grades")
                        </a>
                    }
                    <a asp-controller="Courses" asp-action="Grades" asp-route-id="@a.CourseId" class="btn btn-default btn-sm">Open gradebook</a>
                </div>
            </section>
        }
    </aside>
</div>
