@model AssignmentFormViewModel
@{
    Layout = "_CourseLayout";
    ViewData["Title"] = "New assignment";
    ViewData["Crumb"] = "New assignment";
}
<h2 class="section-title">New assignment</h2>
<form asp-action="Create" method="post" class="panel" novalidate>
    <div class="panel-head"><h3 class="panel-title">Assignment details</h3></div>
    <div class="panel-body">
        <partial name="_AssignmentForm" model="Model" />
    </div>
    <div class="panel-foot d-flex justify-content-end gap-2">
        <a asp-controller="Courses" asp-action="Assignments" asp-route-id="@Model.CourseId" class="btn btn-default">Cancel</a>
        <button type="submit" class="btn btn-primary">Publish assignment</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
